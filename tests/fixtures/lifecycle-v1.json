{
  "version": 1,
  "transport": "POST HTTPS /api/lifecycle/v1/{action}",
  "public_fields": ["version", "operation_id", "role", "subject", "action", "state", "expires_at", "overlap_until", "credential_id"],
  "delivery_extra_fields": ["credential", "save_required"],
  "recovery_redemption_extra_fields": ["operation_id", "save_required"],
  "operation_id": "11111111111111111111111111111111",
  "queue_seconds": 86400,
  "overlap_seconds": 300,
  "sequence": ["queued", "pending", "delivered", "acknowledged", "completed"],
  "ack": {"operation_id": "11111111111111111111111111111111", "saved": true},
  "ack_authentication": "replacement bearer after durable save",
  "lost_delivery": "never redisclose; explicit owner recovery/re-pair",
  "lost_ack": "retry same ACK with durably saved replacement",
  "new_ws_frames": []
}
