# --- LLM (pick one) ---
# Quick cloud test:
# OPENAI_API_KEY=sk-...

# Or point at OpenClaw's OpenAI-compatible HTTP API:
# LLM_BASE_URL=http://127.0.0.1:18789/v1
# LLM_API_KEY=your-openclaw-token
# LLM_MODEL=gpt-4.1

# --- STT/TTS backend: wyoming (default) or piper_embedded ---
POC_BACKEND=wyoming

# Wyoming endpoints — same as docker compose when vauxr stack is up
WHISPER_URL=tcp://127.0.0.1:10300
PIPER_URL=tcp://127.0.0.1:10200
PIPER_VOICE=en_US-libritts_r-medium

# Embedded piper (only if POC_BACKEND=piper_embedded; downloads model on first run)
# PIPER_VOICE=en_US-libritts_r-medium
