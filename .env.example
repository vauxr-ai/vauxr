# Owner setup requires no auth environment variables. DEVICE_TOKEN grants no access.
# LAN HTTP/WS is the default; optionally configure trusted HTTPS/WSS.
# OWNER_HTTP_ORIGIN=http://localhost:8080
# See docs/authz/owner-v1.md for the required proxy/firewall boundary and console CLI.
# OWNER_HTTPS_ORIGIN=https://voice.example.test
# OWNER_TRUSTED_PROXIES=127.0.0.1/32
# Optional OPERATOR_TOKEN: generate with vauxr-owner generate-token and supply via
# your deployment secret manager. Explicit empty/invalid values fail startup.
# Removing an override requires restart and explicit console recovery.

# OpenClaw connection (optional — only needed for direct operator WS fallback mode.
# Recommended path is the vauxr-openclaw channel plugin installed in OpenClaw itself;
# see https://github.com/vauxr-ai/vauxr-openclaw)
# OPENCLAW_URL=wss://your-openclaw:18789
# OPENCLAW_TOKEN=your-openclaw-gateway-token

# Wyoming service URLs (optional — Compose defaults shown). On the host-networked
# compose stack these are reached over loopback rather than Docker DNS.
# Nonempty STT_URL/TTS_URL/TTS_VOICE win over WHISPER_URL/PIPER_URL/PIPER_VOICE.
# Empty or unset neutral values use the legacy value, then the default.
# Outside Compose, URL defaults are tcp://whisper:10300 and tcp://piper:10200.
# STT_URL=tcp://127.0.0.1:10300
# TTS_URL=tcp://127.0.0.1:10200

# --- WebRTC realtime transport (in-process Pipecat pipeline) ---
# Enable the realtime path. The whole compose stack runs on host networking
# because aiortc gathers ICE on unpredictable ephemeral UDP ports that can't be
# published in bridge mode. (optional — default 0)
# REALTIME_ENABLED=1
# esp_peer SDP compatibility munging for the ESP32 firmware. (optional — default 1)
# REALTIME_ESP32=1
# REQUIRED when REALTIME_ENABLED=1: the server's LAN IP/hostname. The device
# builds an absolute /api/offer URL from it (sent in the hello policy) and
# aiortc advertises it as a reachable ICE candidate host.
# REALTIME_HOST=192.168.1.50
# STUN server for ICE. (optional — default stun:stun.l.google.com:19302)
# REALTIME_STUN_URL=stun:stun.l.google.com:19302

# WebSocket server port (optional — default 8765)
# WS_PORT=8765

# HTTP API server port (optional — default 8080)
# HTTP_PORT=8080

# Wyoming TTS voice.name (must already exist on the selected service)
# TTS_VOICE=en_US-libritts_r-medium

# Streaming TTS — idle-pause threshold in milliseconds.
# When the assistant's delta stream goes silent for this long, the
# accumulated buffer is flushed to TTS as an early audio segment so
# replies start playing while the agent is still thinking or running
# tools. Lower = snappier but more fragmentation; higher = smoother
# prosody but more latency. (optional — default 400)
# STREAMING_TTS_IDLE_PAUSE_MS=400

# Log level (optional — default info)
# LOG_LEVEL=info

# Speech selection preserves WHISPER_URL / PIPER_URL / PIPER_VOICE defaults.
# Optional additional operator-configured Wyoming model endpoints:
#   ${DATA_DIR}/speech-providers.json (restart to reload; no model installs)
# UI/API choices persist in ${DATA_DIR}/speech-settings.json.
# See docs/speech-settings.md for generic Wyoming and legacy adapter examples.

# Optional CPU Parakeet v3 + Wyoming Kokoro services (no selection changes):
# docker compose --profile speech-extra up -d parakeet-v3 kokoro
# Dedicated persistent model caches; paths belong to the Docker daemon host.
# PARAKEET_CACHE_DIR=./data/parakeet-v3
# KOKORO_CACHE_DIR=./data/kokoro
# Endpoints are loopback-only :10310 (STT) and :10210 (TTS).
# Optional services use bridge networking with host-loopback published ports.
# Host-network Vauxr uses 127.0.0.1:10310 / :10210, not Compose service DNS.
# Register them in DATA_DIR/speech-providers.json after Describe/inference checks;
# see docs/speech-settings.md. Do not change STT_URL/TTS_URL to register choices.
