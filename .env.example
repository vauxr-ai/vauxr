# All settings in this file are optional overrides. Vauxr starts without a .env
# file; the local browser URL is http://localhost:8080.
# DEVICE_TOKEN grants no owner access. Set OWNER_HTTP_ORIGIN only when the browser
# uses another machine, LAN IP/hostname, or external port.
# OWNER_HTTP_ORIGIN=http://localhost:8080
# See README.md and docs/how-to.md for the owner origin and console claim flow.
# OWNER_HTTPS_ORIGIN=https://voice.example.test
# OWNER_TRUSTED_PROXIES=127.0.0.1/32
# Optional OPERATOR_TOKEN: generate with vauxr-owner generate-token and supply via
# your deployment secret manager. Explicit empty/invalid values fail startup.
# Removing an override requires restart and explicit console recovery.

# OpenClaw connection (optional — only needed for direct operator WS fallback mode.
# Recommended path is the vauxr-openclaw channel plugin installed in OpenClaw itself;
# see https://github.com/vauxr-ai/vauxr-openclaw)
# OPENCLAW_URL=wss://your-openclaw:18789
# OPENCLAW_TOKEN=your-openclaw-gateway-token

# Wyoming service URLs (optional). Native defaults use loopback; Compose defaults
# use whisper/piper service names if you opt in to its local-speech profile.
# Once created, data/speech.json owns the provider endpoints.
# Nonempty STT_URL/TTS_URL/TTS_VOICE win over WHISPER_URL/PIPER_URL/PIPER_VOICE.
# Empty or unset neutral values use the legacy value, then the default.
# Outside Compose, URL defaults are tcp://127.0.0.1:10300 and tcp://127.0.0.1:10200.
# STT_URL=tcp://127.0.0.1:10300
# TTS_URL=tcp://127.0.0.1:10200

# --- WebRTC realtime transport (in-process Pipecat pipeline) ---
# Native runs enable WebRTC by default when installed with the [realtime] extra.
# Compose disables it by default while bridge-mode WebRTC is investigated.
# Existing config.json realtime.enabled takes precedence over environment values.
# REALTIME_ENABLED=0
# esp_peer SDP compatibility munging for the ESP32 firmware. (optional — default 1)
# REALTIME_ESP32=1
# Optional ICE host override. By default Vauxr selects the local IPv4 address
# matching the trusted owner origin (localhost for a local browser). A physical
# device needs an exact reachable OWNER_HTTP_ORIGIN / OWNER_HTTPS_ORIGIN. Proxy
# origins that do not resolve locally need this separate ICE host override.
# REALTIME_HOST=192.168.1.50
# STUN server for ICE across networks. Local/LAN ICE needs none by default.
# REALTIME_STUN_URL=stun:stun.l.google.com:19302

# WebSocket server port (optional — default 8765)
# WS_PORT=8765

# HTTP API server port (optional — default 8080)
# HTTP_PORT=8080

# Wyoming TTS voice.name (must already exist on the selected service)
# TTS_VOICE=en_US-libritts_r-medium

# Streaming TTS — idle-pause threshold in milliseconds.
# When the assistant's delta stream goes silent for this long, the
# accumulated buffer is flushed to TTS as an early audio segment so
# replies start playing while the agent is still thinking or running
# tools. Lower = snappier but more fragmentation; higher = smoother
# prosody but more latency. (optional — default 400)
# STREAMING_TTS_IDLE_PAUSE_MS=400

# Log level (optional — default info)
# LOG_LEVEL=info

# Speech providers and selections persist in ${DATA_DIR}/speech.json.
# Use the management UI/API to configure additional Wyoming deployments; a
# registry entry does not install a model or start a service.
# See docs/configuration.md for provider endpoints and inherited selections.

# Optional CPU Parakeet v3 + Wyoming Kokoro services (no selection changes):
# docker compose --profile speech-extra up -d parakeet-v3 kokoro
# Dedicated persistent model caches; paths belong to the Docker daemon host.
# PARAKEET_CACHE_DIR=./data/parakeet-v3
# KOKORO_CACHE_DIR=./data/kokoro
# Endpoints are loopback-only :10310 (STT) and :10210 (TTS).
# Optional services use bridge networking with host-loopback published ports.
# Bridge-network Vauxr uses Compose DNS for container-local services.
# Register them in DATA_DIR/speech.json after Describe/inference checks; see
# docs/configuration.md. Do not change STT_URL/TTS_URL to register choices.

# Optional native HTTPS/WSS
HTTPS_ENABLED=0
# HTTPS_PORT=8443
# HTTPS_CERT_FILE=/data/tls/fullchain.pem
# HTTPS_KEY_FILE=/data/tls/privkey.pem
# OWNER_HTTPS_ORIGIN=https://voice.example.com:8443
# Alternative: explicitly opt in to Certbot Route53 (no manual cert/key paths).
ACME_ROUTE53_ENABLED=0
# ACME_DOMAIN=voice.example.com
# ACME_EMAIL=operator@example.com
ACME_ACCEPT_TOS=0
ACME_STAGING=0
# AWS_SHARED_CREDENTIALS_FILE=/run/secrets/route53
# AWS_PROFILE=default
